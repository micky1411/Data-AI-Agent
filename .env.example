# Local development only. Copy to .env; never commit real credentials.
AIRFLOW_IMAGE=dataops-airflow:3.3.0
AIRFLOW_PORT=8080
AGENT_WEBHOOK_URL=http://host.docker.internal:8000/events/airflow
AIRFLOW_API_SECRET=local-development-api-secret-change-before-any-shared-deployment
AIRFLOW_JWT_SECRET=local-development-jwt-secret-change-before-any-shared-deployment-1234567890

POSTGRES_PORT=5432
POSTGRES_PASSWORD=airflow-local-only
ETL_RW_PASSWORD=etl-local-only
AGENT_RO_PASSWORD=agent-readonly-local-only

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-local-only
